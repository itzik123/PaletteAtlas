{
  // Browser code: adds DOM types, plus Vite's types for CSS imports and import.meta.env.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"]
  },
  "include": ["src"],
  // Checked on their own, with the WebWorker library instead of the DOM (see src/workers/tsconfig.json).
  "exclude": ["src/workers"]
}
